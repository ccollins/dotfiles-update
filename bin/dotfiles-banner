#!/usr/bin/env bash
# dotfiles-banner — print the celebratory "dotfiles" banner, Oh My Zsh style.
#
# The one canonical copy of the art: the zsh plugin prints it after an apply /
# self-update, and a bootstrap script can print it at the end of a fresh install
# by calling this on PATH. Nothing here is zsh-specific on purpose.
#
#   dotfiles-banner "applied at 9450ad0 · 7 packages restowed"
#   dotfiles-banner --tagline "welcome to a new Mac" "bootstrap complete"
#   dotfiles-banner --no-tagline "all green"
#
# Color is dropped when stdout isn't a terminal, when NO_COLOR is set, or when
# the terminal can't do at least 8 colors — the art is plain ASCII-safe box
# drawing either way.
set -uo pipefail

tagline=""
no_tagline=0
while [ $# -gt 0 ]; do
  case "$1" in
    --tagline)    tagline="${2:-}"; shift 2 ;;
    --no-tagline) no_tagline=1; shift ;;
    -h|--help)    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --)           shift; break ;;
    *)            break ;;
  esac
done
message="${1:-}"

# 8 rainbow stops — one per letter of "dotfiles", so the color runs across the
# word rather than down it (same trick Oh My Zsh's upgrade banner uses).
depth=0
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  depth=$(TERM="${TERM:-dumb}" tput colors 2>/dev/null || echo 0)
fi
if [ "$depth" -ge 256 ]; then
  RAINBOW=()
  for c in 196 208 220 46 51 33 129 201; do RAINBOW+=("$(printf '\033[1;38;5;%sm' "$c")"); done
  RESET=$(printf '\033[0m'); BOLD=$(printf '\033[1m'); DIM=$(printf '\033[2m')
elif [ "$depth" -ge 8 ]; then
  RAINBOW=()
  for c in 31 33 33 32 36 34 35 35; do RAINBOW+=("$(printf '\033[1;%sm' "$c")"); done
  RESET=$(printf '\033[0m'); BOLD=$(printf '\033[1m'); DIM=$(printf '\033[2m')
else
  RAINBOW=("" "" "" "" "" "" "" "")
  RESET=""; BOLD=""; DIM=""
fi

# Each row carries one %s per letter plus a trailing %s for the reset.
ART=(
  '%s██████╗ %s ██████╗ %s████████╗%s███████╗%s██╗%s██╗     %s███████╗%s███████╗%s'
  '%s██╔══██╗%s██╔═══██╗%s╚══██╔══╝%s██╔════╝%s██║%s██║     %s██╔════╝%s██╔════╝%s'
  '%s██║  ██║%s██║   ██║%s   ██║   %s█████╗  %s██║%s██║     %s█████╗  %s███████╗%s'
  '%s██║  ██║%s██║   ██║%s   ██║   %s██╔══╝  %s██║%s██║     %s██╔══╝  %s╚════██║%s'
  '%s██████╔╝%s╚██████╔╝%s   ██║   %s██║     %s██║%s███████╗%s███████╗%s███████║%s'
  '%s╚═════╝ %s ╚═════╝ %s   ╚═╝   %s╚═╝     %s╚═╝%s╚══════╝%s╚══════╝%s╚══════╝%s'
)

TAGLINES=(
  "your Mac, exactly as you left it"
  "stow did the walking"
  "every symlink pointing somewhere real"
  "one repo, every machine"
  "future you says thanks"
  "no snowflakes were harmed"
  "reproducible by construction"
  "fresh laptop, same shell"
  "committed, pushed, applied"
  "the config is the product"
)

echo
for row in "${ART[@]}"; do
  # shellcheck disable=SC2059  # the format string is ours; the args are colors
  printf "$row\n" "${RAINBOW[@]}" "$RESET"
done
[ -n "$message" ] && printf '\n   %s✨ %s%s\n' "$BOLD" "$message" "$RESET"
if [ "$no_tagline" -eq 0 ]; then
  [ -n "$tagline" ] || tagline="${TAGLINES[$((RANDOM % ${#TAGLINES[@]}))]}"
  printf '   %s   %s%s\n' "$DIM" "$tagline" "$RESET"
fi
echo
