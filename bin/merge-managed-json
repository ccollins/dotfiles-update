#!/usr/bin/env bash
# merge-managed-json — reconcile a config file that its OWNING APP rewrites.
#
# Some tools own and continuously rewrite their JSON config (e.g. an editor or CLI
# that persists UI/model/account choices), so you can't just symlink a tracked copy
# in with stow — the app's edits would fight git. Instead track a SHARED base
# (<name>.base.json) and merge it into the live file here: base is authoritative for
# shared keys, while a declared set of MACHINE-LOCAL keys is preserved from whatever
# the app last wrote. Only TOP-LEVEL keys are handled. Idempotent; safe to re-run.
#
# Usage: merge-managed-json <base.json> <live.json> [local-key ...]
#   base.json   tracked shared config (source of truth for shared keys)
#   live.json   the file the app owns/rewrites (regenerated here)
#   local-key   top-level keys to keep per-machine from the live file (repeatable)
#
# Because base is authoritative, live edits to SHARED keys (e.g. enabling a plugin
# in-app) are reverted on the next run — this prints a loud warning naming them so
# it's never silent. Promote them into the base first with `capture-managed-json`.
#
# A key is SHARED only if the base defines it. A live key that is in neither the base
# nor the local list (typically a setting the app added since the base was captured)
# is kept as-is with a notice, never deleted: nobody has decided yet whether it is
# shared or local. Whenever a run changes an existing live file, the previous
# contents are saved to <live>.bak first, so a revert is always recoverable.
#
# Removing a key from the base does NOT remove it from live files (this machine or
# any other that already synced it). So each run records the base it applied in
# <live>.last-base, and the next run names any key that has since left the base but
# is still set here, once, so the leftover is a decision rather than a surprise.
#
# Example — Claude Code, keeping the per-machine model out of git:
#   merge-managed-json "$DOTFILES/claude/settings.base.json" \
#                      "$HOME/.claude/settings.json" model
set -euo pipefail

BASE="${1:?usage: merge-managed-json <base.json> <live.json> [local-key ...]}"
LIVE="${2:?usage: merge-managed-json <base.json> <live.json> [local-key ...]}"
shift 2                     # remaining args = machine-local keys to preserve

command -v jq >/dev/null || { echo "merge-managed-json: jq not found" >&2; exit 1; }
[ -f "$BASE" ] || { echo "merge-managed-json: base not found: $BASE" >&2; exit 1; }

mkdir -p "$(dirname "$LIVE")"
trap 'rm -f "$LIVE.tmp"' EXIT   # never strand a temp file on a mid-run failure

# Current live keys (follows a legacy stow symlink). Fall back to {} if the file is
# missing, a dangling symlink, or not valid JSON.
current='{}'
if [ -e "$LIVE" ]; then
  current="$(cat "$LIVE" 2>/dev/null || echo '{}')"
  printf '%s' "$current" | jq empty >/dev/null 2>&1 || current='{}'
fi

# Warn (don't silently revert) when the live file has changes to SHARED keys (keys
# the base defines) that aren't in the base.
drift="$(jq -rn --slurpfile base "$BASE" --argjson cur "$current" '
  ($ARGS.positional) as $local | $base[0] as $b
  | [ $cur | keys[] | . as $k | select(($local | index($k)) | not)
      | select($b | has($k)) | select($cur[$k] != $b[$k]) ] | .[]
' --args "$@" 2>/dev/null || true)"
if [ -n "$drift" ]; then
  echo "merge-managed-json: WARNING — $LIVE has shared changes not in the base;" >&2
  echo "  reverting to base for: $(echo "$drift" | paste -sd, -)" >&2
  echo "  previous file saved to: $LIVE.bak" >&2
  echo "  keep them with: capture-managed-json \"$BASE\" \"$LIVE\" ${*:-}" >&2
fi

# Keys the previously applied base had, the current base dropped, and this live file
# still carries. Not deleted (see header); named once so the leftover is deliberate.
LAST_BASE="$LIVE.last-base"
prev='{}'
if [ -f "$LAST_BASE" ]; then
  prev="$(cat "$LAST_BASE")"
  printf '%s' "$prev" | jq -e 'type == "object"' >/dev/null 2>&1 || prev='{}'
fi
removed="$(jq -rn --slurpfile base "$BASE" --argjson cur "$current" --argjson prev "$prev" '
  ($ARGS.positional) as $local | $base[0] as $b
  | [ $prev | keys[] | . as $k | select(($b | has($k)) | not)
      | select(($local | index($k)) | not) | select($cur | has($k)) ]
  | .[]
' --args "$@" 2>/dev/null || true)"
if [ -n "$removed" ]; then
  echo "merge-managed-json: NOTICE — removed from the base but still set in $LIVE: $(echo "$removed" | paste -sd, -)" >&2
  echo "  they stay on this machine and on any other machine that synced them;" >&2
  echo "  delete them from each live file by hand if they should be gone" >&2
fi

# Live keys the base doesn't define and that aren't declared local are kept, not
# dropped. Say so, since they won't reach other machines until someone decides.
# (Keys just reported as removed are left out so this run doesn't name them twice.)
unmanaged="$(jq -rn --slurpfile base "$BASE" --argjson cur "$current" --arg removed "$removed" '
  ($ARGS.positional) as $local | $base[0] as $b
  | ($removed | split("\n")) as $gone
  | [ $cur | keys[] | . as $k | select(($local | index($k)) | not)
      | select(($b | has($k)) | not) | select(($gone | index($k)) | not) ]
  | .[]
' --args "$@" 2>/dev/null || true)"
if [ -n "$unmanaged" ]; then
  echo "merge-managed-json: note — keeping keys the base doesn't define: $(echo "$unmanaged" | paste -sd, -)" >&2
  echo "  share them with capture-managed-json, or list them as local keys" >&2
fi

# base wins for shared keys; graft each requested machine-local key from the live
# file when it's present (non-null), and keep any key the base doesn't define.
jq -n --slurpfile base "$BASE" --argjson cur "$current" '
  ($ARGS.positional) as $local | $base[0] as $b
  | ($cur | with_entries(select(.key as $k
      | (($b | has($k)) | not) and (($local | index($k)) | not)))) as $unmanaged
  | $unmanaged + $b
  + ( reduce $local[] as $k ({};
        if ($cur[$k] != null) then . + {($k): $cur[$k]} else . end) )
' --args "$@" > "$LIVE.tmp"

# Back up the previous contents before changing them (skip when nothing changes, so
# an idempotent re-run doesn't clobber the last useful backup).
# Copy the raw bytes, not the parsed JSON, so even an unparseable file survives.
if [ -e "$LIVE" ] && [ "$(jq -S . "$LIVE" 2>/dev/null)" != "$(jq -S . "$LIVE.tmp")" ]; then
  cat "$LIVE" > "$LIVE.bak"
fi

# Replace a legacy stow symlink with a real file we own (writing through it would
# corrupt the tracked source).
[ -L "$LIVE" ] && rm -f "$LIVE"
mv -f "$LIVE.tmp" "$LIVE"

# Record what was applied so the next run can tell which keys left the base.
jq . "$BASE" > "$LAST_BASE"

echo "merge-managed-json: wrote $LIVE (preserved local: ${*:-none})"
